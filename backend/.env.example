# Lograke backend environment configuration.
# Copy to backend/.env — the backend loads .env from its working directory.
# See the repository-root .env.example for the fully commented template.

PORT=5000
NODE_ENV=development
CORS_ORIGIN=*
CORS_CREDENTIALS=false
AUTH_ENABLED=true
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRES_IN=7d
ACTIVE_AI_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
MAX_FILE_SIZE=10485760
MAX_JSON_BODY=10mb
LOG_LEVEL=info

# Optional — see the root .env.example for details:
# DB_PATH=./data/lograke.db
# PUBLIC_URL=https://logs.example.com
# TRUST_PROXY=1
# ALLOW_PRIVATE_URLS=false
# GROQ_MODELS=
# GEMINI_MODELS=
# GROK_MODELS=
# OLLAMA_MODELS=
