{
  "name": "lograke",
  "version": "1.0.0",
  "description": "Universal adaptive log intelligence platform — ingest, parse, search, and visualize logs with AI-powered insights.",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "main": "src/index.js",
  "bin": {
    "lograke": "bin/lograke.js"
  },
  "files": [
    "bin/",
    "src/",
    "public/",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node src/index.js",
    "dev": "node src/index.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --forceExit --detectOpenHandles",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch --forceExit",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage --forceExit",
    "prepack": "node scripts/prepare-package.mjs"
  },
  "keywords": [
    "log-analysis",
    "logging",
    "observability",
    "log-management",
    "monitoring",
    "ai"
  ],
  "author": "Lograke Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/Haimanot25/lograke"
  },
  "homepage": "https://github.com/Haimanot25/lograke#readme",
  "bugs": {
    "url": "https://github.com/Haimanot25/lograke/issues"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "adm-zip": "^0.5.17",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "safe-regex2": "^5.1.2",
    "ssh2-sftp-client": "^12.1.1",
    "tar": "^7.5.16",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.3.1"
  }
}
