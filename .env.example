# Lograke Environment Configuration

# Copy this file to .env and update values as needed

# ── Server ──────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── CORS ────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * for all
CORS_ORIGIN=*

# ── Authentication ──────────────────────────────────────────────
# Authentication is ON by default. Set to "false" to disable it
# (not recommended for shared/production deployments).
# The first user to register becomes the admin.
AUTH_ENABLED=true
# Required in production — the server refuses to start without it.
# In development a random ephemeral secret is generated if unset.
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRES_IN=7d

# ── AI Providers ────────────────────────────────────────────────
# Active provider: groq | gemini | grok | ollama
ACTIVE_AI_PROVIDER=groq

# Groq (free, recommended default)
# Get a key from: https://console.groq.com/
GROQ_API_KEY=

# Google Gemini
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=

# Grok (xAI)
# Get a key from: https://console.x.ai/
GROK_API_KEY=

# Ollama (local, no API key needed)
OLLAMA_BASE_URL=http://localhost:11434

# ── Reverse proxy ───────────────────────────────────────────────
# Number of trusted proxy hops (e.g. 1) or an express trust value.
# Set this when running behind nginx/traefik/cloudflare so that
# rate limiting keys on the real client IP. Leave unset otherwise.
# TRUST_PROXY=1

# ── Outbound fetch restrictions ─────────────────────────────────
# Allow http_poll log sources to target localhost / loopback URLs.
# Off by default (SSRF protection). Set to true only if you need it.
# ALLOW_PRIVATE_URLS=false

# ── AI model overrides (optional) ───────────────────────────────
# Comma-separated model IDs, overrides the built-in model list per provider.
# GROQ_MODELS=
# GEMINI_MODELS=
# GROK_MODELS=
# OLLAMA_MODELS=

# ── Upload Limits ───────────────────────────────────────────────
MAX_JSON_BODY=10mb
MAX_FILE_SIZE=10485760

# ── Logging ─────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Frontend ────────────────────────────────────────────────────
# (for frontend/.env, not this file)
# VITE_API_BASE=http://localhost:5000/api
