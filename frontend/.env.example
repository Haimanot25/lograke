# Vite only reads .env files from this directory (frontend/).
#
# Default: leave VITE_API_BASE unset. The dev server proxies /api to
# http://localhost:5000 (see vite.config.js) and the production backend
# serves the built frontend from the same origin — both are same-origin,
# so the auth cookie is sent automatically.
#
# Only set this if the API lives on a different origin. When you do,
# the backend must allow that origin via CORS_ORIGIN and CORS_CREDENTIALS=true.
# VITE_API_BASE=http://localhost:5000/api
