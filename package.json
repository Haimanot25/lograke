{
  "name": "lograke",
  "version": "1.0.0",
  "private": true,
  "description": "Universal Adaptive Log Intelligence Platform",
  "scripts": {
    "install:all": "cd backend && npm install && cd ../frontend && npm install",
    "dev": "concurrently \"cd backend && npm start\" \"cd frontend && npm run dev\"",
    "build": "cd frontend && npm run build",
    "start": "cd backend && npm start",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd backend && npm test",
    "test:frontend": "cd frontend && npm test",
    "test:coverage": "npm run test:coverage:backend && npm run test:coverage:frontend",
    "test:coverage:backend": "cd backend && npm run test:coverage",
    "test:coverage:frontend": "cd frontend && npm run test:coverage",
    "test:e2e": "cd e2e && npx playwright test",
    "install:e2e": "cd e2e && npm install && npx playwright install chromium"
  },
  "keywords": [
    "log-analysis",
    "logging",
    "analytics",
    "monitoring"
  ],
  "author": "Lograke Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Haimanot25/lograke"
  },
  "homepage": "https://github.com/Haimanot25/lograke#readme",
  "bugs": {
    "url": "https://github.com/Haimanot25/lograke/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
